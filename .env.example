# ============================================
# alpha-bench Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# LLM APIs
# ============================================

# Anthropic Claude API
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Code API (if different from standard Anthropic key)
CLAUDE_CODE_API_KEY=your_claude_code_api_key_here

# ============================================
# Market Data APIs
# ============================================

# Your market data provider API key
# Examples: Alpha Vantage, Yahoo Finance, Alpaca, Polygon.io
MARKET_DATA_API_KEY=your_market_data_api_key_here

# Market data API base URL
MARKET_DATA_BASE_URL=https://api.yourprovider.com

# Optional: Specific provider configs
# ALPHA_VANTAGE_KEY=your_key
# ALPACA_API_KEY=your_key
# ALPACA_SECRET_KEY=your_secret
# POLYGON_API_KEY=your_key

# ============================================
# Airflow Configuration
# ============================================

# Airflow home directory (where DB and logs are stored)
AIRFLOW_HOME=/c/dev/alpha-bench/airflow_home

# DAGs folder (should point to alpha_bench/airflow_dags)
AIRFLOW__CORE__DAGS_FOLDER=/c/dev/alpha-bench/alpha_bench/airflow_dags

# Database connection (SQLite for local, PostgreSQL for production)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////c/dev/alpha-bench/airflow_home/airflow.db

# Executor (SequentialExecutor for local, CeleryExecutor for production)
AIRFLOW__CORE__EXECUTOR=SequentialExecutor

# Load examples (set to False to hide Airflow example DAGs)
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ============================================
# Benchmark Configuration
# ============================================

# Default lookback window in hours (how much historical data to use)
DEFAULT_LOOKBACK_HOURS=72

# Default forecast horizon in hours (how far ahead to simulate)
DEFAULT_FORECAST_HOURS=24

# Default run schedule (cron format: "minute hour day month dayofweek")
# Examples:
#   "0 */6 * * *"  = Every 6 hours
#   "0 */4 * * *"  = Every 4 hours
#   "0 0 * * *"    = Daily at midnight
DEFAULT_RUN_SCHEDULE="0 */6 * * *"

# Initial capital for simulations (in USD)
INITIAL_CAPITAL=10000

# Default risk cap per trade (fraction of capital)
DEFAULT_RISK_CAP=0.01

# Trading fees (maker/taker)
TRADING_FEE_RATE=0.001

# Slippage simulation (fraction)
SLIPPAGE_RATE=0.0005

# ============================================
# Data Storage
# ============================================

# Data retention period (days)
RAW_DATA_RETENTION_DAYS=90
AGGREGATED_DATA_RETENTION_DAYS=365

# Parquet compression (snappy, gzip, brotli, or none)
PARQUET_COMPRESSION=snappy

# ============================================
# Dashboard
# ============================================

# Streamlit server settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# ============================================
# Logging
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=/c/dev/alpha-bench/logs/alpha_bench.log

# ============================================
# Development
# ============================================

# Enable debug mode (more verbose logging, no caching)
DEBUG=False

# Pytest verbosity
PYTEST_VERBOSE=1

# ============================================
# Optional: External Services
# ============================================

# Weights & Biases (for experiment tracking)
# WANDB_API_KEY=your_wandb_key
# WANDB_PROJECT=alpha-bench

# Sentry (for error tracking)
# SENTRY_DSN=your_sentry_dsn

# Slack notifications
# SLACK_WEBHOOK_URL=your_slack_webhook_url

# Email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# NOTIFICATION_EMAIL=alerts@yourcompany.com

# ============================================
# Security
# ============================================

# Secret key for any encryption/signing needs
SECRET_KEY=change_this_to_a_random_string_in_production

# Enable/disable certain features in production
ENABLE_LIVE_TRADING=False  # ALWAYS False for this benchmark system
